# ==========================================
# BudgetPath Pro – Git Ignore Rules
# ==========================================

# 1. Environment & Credentials (CRITICAL: Never commit secrets)
.env
Backend/.env
*.env
*.env.local
*.env.*.local
# Allow .env.example template to be tracked
!.env.example
!Backend/.env.example

# 2. Python Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# 3. Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# 4. Logs, Runtime & Debugging
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.logs/

# 5. Database & Local Storage
*.sqlite
*.sqlite3
*.db

# 6. IDEs & Editors
.idea/
.vscode/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# 7. Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# 8. Temporary Files & Scratch
tmp/
temp/
scratch/

# 9. Binary Installers & Large Executables
*.exe
*.msi
*.dmg
*.pkg

# 10. Vercel Deployment Artifacts
.vercel

